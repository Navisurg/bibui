<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../../packaging/PublicPackage.props" />

  <!-- A bibui app in one package: bibui, a native Wayland window drawn by Skia on the CPU, no GL.
       BibuiApp is the same type in every Bibui.App package (../BibuiApp.cs);
       this package names its window and renderer, and says how they open and
       draw (WaylandSkiaCpu.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.App.WaylandSkiaCpu</AssemblyName>
    <RootNamespace>Bibui.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Bibui.App.WaylandSkiaCpu</PackageId>
    <Description>A bibui app in one package: bibui, a native Wayland window drawn by Skia on the CPU, no GL. BibuiApp opens the window and renderer and runs the frame in two calls; the same type in every Bibui.App package.</Description>
    <PackageTags>$(PackageTags);wayland;skia;cpu</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The window and renderer this package is, under the names BibuiApp.cs uses. -->
    <Using Include="Bibui.Platform.Wayland.WaylandWindow" Alias="AppWindow" />
    <Using Include="Bibui.Raster.Skia.SkiaCpuRenderer" Alias="AppRenderer" />
    <Compile Include="../BibuiApp.cs" Link="BibuiApp.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui/bibui.csproj" />
    <ProjectReference Include="../../bibui-platform-wayland/bibui-platform-wayland.csproj" />
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
