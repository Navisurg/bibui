<Project Sdk="Microsoft.NET.Sdk">
  <!-- The README's quick start: a Silk window drawn with Skia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>counter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui/bibui.csproj" />
    <ProjectReference Include="../../bibui-platform-silk/bibui-platform-silk.csproj" />
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
  </ItemGroup>
</Project>
