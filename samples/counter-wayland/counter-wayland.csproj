<Project Sdk="Microsoft.NET.Sdk">
  <!-- The counter as one Native AOT binary: Bibui.App.WaylandManaged, a Wayland window and the managed rasterizer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>counter-wayland</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app is samples/counter; this project only picks its package. -->
    <Compile Include="../counter/*.cs" />
    <ProjectReference Include="../../bibui-apps/wayland-managed/bibui-app-wayland-managed.csproj" />
  </ItemGroup>
</Project>
