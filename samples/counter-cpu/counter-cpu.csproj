<Project Sdk="Microsoft.NET.Sdk">
  <!-- The counter drawn on the CPU: Skia into memory, shown on a Silk window's GL framebuffer, through Bibui.App.SilkSkiaCpu. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>counter-cpu</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app is samples/counter; this project only picks its package. -->
    <Compile Include="../counter/*.cs" />
    <ProjectReference Include="../../bibui-apps/silk-skia-cpu/bibui-app-silk-skia-cpu.csproj" />
  </ItemGroup>
</Project>
