<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bibui-app</AssemblyName>
    <RootNamespace>BibuiApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui-core/bibui-core.csproj" />
    <!-- The window (GLFW + GL) and the renderer that draws into it. -->
    <ProjectReference Include="../../bibui-platform-silk/bibui-platform-silk.csproj" />
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
    <!-- The test port, opened when BIBUI_TEST_PORT=1. -->
    <ProjectReference Include="../../bibui-automation/bibui-automation.csproj" />
  </ItemGroup>
</Project>
