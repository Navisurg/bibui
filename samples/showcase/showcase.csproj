<Project Sdk="Microsoft.NET.Sdk">
  <!-- Zenith, an observatory console, the showcase of what bibui can do.
       Its window and renderer are a Bibui.App package, chosen at build time
       (-p:App=..., ../BibuiApp.props; see Program.cs for the commands).
       -p:App=WaylandManaged publishes with Native AOT, with no Silk or Skia in
       the binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>showcase</AssemblyName>
    <RootNamespace>Showcase</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <Import Project="../BibuiApp.props" />
  <ItemGroup>
    <!-- The managed rasterizer draws the headless pictures with any package. -->
    <ProjectReference Include="../../bibui-raster-managed/backend/Bibui.Raster.Managed.Backend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Theme files the Appearance sheet offers, beside the binary. -->
    <None Include="themes/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="themes" />
  </ItemGroup>
</Project>
