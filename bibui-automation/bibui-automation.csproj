<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bibui.Automation: what lets a client drive a running app, out of the core,
       so an app that does not reference it ships no automation code. TestPort is
       its first part. Not published until it replaces BibuiTestServer: then it
       imports ../packaging/PublicPackage.props, gets
       packaging/readme/Bibui.Automation.md, and joins nuget-publish.sh. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Automation</AssemblyName>
    <RootNamespace>Bibui.Automation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <UseAppHost>false</UseAppHost>
    <PackageId>Bibui.Automation</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui-core/bibui-core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The port thread's and AnswerCmds' steps (Publish, EndFrame, Release) are
         tested directly, in place of a socket. -->
    <InternalsVisibleTo Include="automation-tests" />
  </ItemGroup>
</Project>
