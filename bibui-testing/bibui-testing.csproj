<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bibui-testing</AssemblyName>
    <RootNamespace>Bibui.Testing</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <UseAppHost>false</UseAppHost>
    <PackageId>Bibui.Testing</PackageId>
    <Description>Playwright-style semantic testing API for Bibui apps. Provides BibuiPage and IBibuiPage for headless component testing.</Description>
    <PackageTags>$(PackageTags);testing;headless;ui-testing</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Skia: what BibuiPage.Launch renders with, named rather than defaulted. -->
    <ProjectReference Include="../bibui-raster-skia/bibui-raster-skia.csproj" />
    <ProjectReference Include="../bibui/bibui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
