<Project Sdk="Microsoft.NET.Sdk">
  <!-- The raw Wayland host drawing with Skia on the GPU (EGL + Skia's GL
       backend), chosen by the host because the backend is Skia. Publishes
       with Native AOT, every warning an error:
       dotnet publish tests/wayland-gpu-hello -c Release -r linux-x64 -p:PublishAot=true -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>wayland-gpu-hello</AssemblyName>
    <RootNamespace>WaylandGpuHello</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui-platform-wayland/bibui-platform-wayland.csproj" />
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
  </ItemGroup>
</Project>
