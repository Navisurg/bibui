<Project Sdk="Microsoft.NET.Sdk">
  <!-- The public API of every bibui package, frozen as one text file per
       assembly (api/<assembly>.txt). Run as a console app: it fails when an
       assembly's public surface differs from its checked-in file, and
       its update argument rewrites the files, so a change to the API is a reviewed diff.
       PublicApiGenerator is a dependency of this test only, never of a package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>public-api</AssemblyName>
    <RootNamespace>Bibui.PublicApi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every package nuget-publish.sh packs. Referenced so their assemblies
         sit beside this one. -->
    <ProjectReference Include="../../bibui/bibui.csproj" />
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
    <ProjectReference Include="../../bibui-platform-silk/bibui-platform-silk.csproj" />
    <ProjectReference Include="../../bibui-testing/bibui-testing.csproj" />
    <ProjectReference Include="../../bibui-text-freetype/Bibui.Text.FreeType.csproj" />
    <ProjectReference Include="../../bibui-raster-managed/src/Bibui.Raster.Managed.csproj" />
    <ProjectReference Include="../../bibui-raster-managed/backend/Bibui.Raster.Managed.Backend.csproj" />
    <ProjectReference Include="../../bibui-platform-wayland/bibui-platform-wayland.csproj" />
  </ItemGroup>
</Project>
