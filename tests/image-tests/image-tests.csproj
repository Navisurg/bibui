<Project Sdk="Microsoft.NET.Sdk">
  <!-- JPEG and WebP decode (Bibui.Imaging, through the system's
       libjpeg-turbo and libwebp) and the format sniffing in front of them,
       checked against known pixels and against SkiaSharp's decode. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>image-tests</AssemblyName>
    <RootNamespace>Bibui.ImageTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui-imaging/bibui-imaging.csproj" />
  </ItemGroup>
</Project>
