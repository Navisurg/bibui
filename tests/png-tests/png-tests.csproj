<Project Sdk="Microsoft.NET.Sdk">
  <!-- The managed PNG codec (bibui/src/Imaging), checked pixel for pixel against
       SkiaSharp's decode of every PNG in the repo. The bench argument times both. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>png-tests</AssemblyName>
    <RootNamespace>Bibui.PngTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Skia: what the parameterless new BibuiRuntime()/BibuiRenderer() draw with. -->
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
    <ProjectReference Include="../../bibui/bibui.csproj" />
  </ItemGroup>
</Project>
