<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>text-tests</AssemblyName>
    <RootNamespace>Bibui.TextTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Skia: what the parameterless new BibuiRuntime()/BibuiRenderer() draw with. -->
    <ProjectReference Include="../../bibui-raster-skia/bibui-raster-skia.csproj" />
    <ProjectReference Include="../../bibui-core/bibui-core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The runtime tests' subset of Noto Color Emoji (OFL), the cluster face clusters are measured in. -->
    <None Include="../bibui-runtime-tests/Fixtures/NotoColorEmoji-subset.ttf" Link="Fixtures/NotoColorEmoji-subset.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
