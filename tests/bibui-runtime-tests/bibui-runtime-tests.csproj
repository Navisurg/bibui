<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bibui-runtime-tests</AssemblyName>
    <RootNamespace>Bibui.RuntimeTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui-testing/bibui-testing.csproj" />
    <!-- Silk.NET.Input, to pin Bibui.Core.Key to it, and the default-host registration. -->
    <ProjectReference Include="../../bibui-platform-silk/bibui-platform-silk.csproj" />
    <!-- The managed rasterizer and the Wayland window, for the tests that
         draw and that drive WindowInput the way a window does. -->
    <ProjectReference Include="../../bibui-raster-managed/backend/Bibui.Raster.Managed.Backend.csproj" />
    <ProjectReference Include="../../bibui-platform-wayland/bibui-platform-wayland.csproj" />
    <!-- The sample's own build (BibuiApp.App), which the full-app tests drive headless. -->
    <ProjectReference Include="../../samples/bibui-app/bibui-app.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Subsets of Noto Color Emoji (CBDT) and Noto Znamenny (COLR), OFL (Fixtures/OFL.txt): the colour glyph tests' fonts. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
