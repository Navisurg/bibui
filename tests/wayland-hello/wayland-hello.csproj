<Project Sdk="Microsoft.NET.Sdk">
  <!-- A bibui app on the raw Wayland host and the managed rasterizer, as the
       Bibui.App.WaylandManaged package puts them together. Publishes with Native AOT:
       dotnet publish tests/wayland-hello -c Release -r linux-x64 -p:PublishAot=true -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>wayland-hello</AssemblyName>
    <RootNamespace>WaylandHello</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bibui-apps/wayland-managed/bibui-app-wayland-managed.csproj" />
  </ItemGroup>
</Project>
