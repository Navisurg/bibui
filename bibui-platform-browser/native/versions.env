# The FreeType and HarfBuzz releases the browser archives are built from, and
# the SHA-256 of each release tarball. build.sh refuses a download that does not
# match. CI keys its cache of the archives on this file and build.sh.
#
# FreeType: the release tarball from savannah.gnu.org, signed by Werner
# Lemberg (key E30674707856409FF1948010BE6C3AAC63AD8E3F); the hash is of the
# file the signature verifies.
FREETYPE_VERSION=2.14.3
FREETYPE_URL=https://download.savannah.gnu.org/releases/freetype/freetype-2.14.3.tar.xz
FREETYPE_SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f
# HarfBuzz: the release asset on GitHub; the hash is the digest GitHub lists for it.
HARFBUZZ_VERSION=11.5.1
HARFBUZZ_URL=https://github.com/harfbuzz/harfbuzz/releases/download/11.5.1/harfbuzz-11.5.1.tar.xz
HARFBUZZ_SHA256=972a60a8d274d49e70361da6920c3a73dfb0fb4387f6c6811906a47ba634d8a1
# The Emscripten the .NET 10 wasm-tools workload links with. The archives are
# built with that emcc, so they link with the app.
EMSCRIPTEN_VERSION=3.1.56
