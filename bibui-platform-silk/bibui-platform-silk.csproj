<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <!-- The cross-platform window: GLFW through Silk.NET, clipboard through
       TextCopy and wl-clipboard. It knows no runtime and no renderer, and opens
       with no graphics API; SilkGl is its OpenGL route (whatever draws a frame
       draws it into the GL framebuffer). An app runs it through a Bibui.App
       package, or opens it with SilkWindow.Open and runs the loop itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Platform.Silk</AssemblyName>
    <RootNamespace>Bibui.Core.Runtime.Platform</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- GLFW's char callback takes the window's handle as a pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Bibui.Platform.Silk</PackageId>
    <Description>Bibui cross-platform window: GLFW through Silk.NET, with SilkGl for OpenGL, clipboard through TextCopy. SilkWindow.Open(SilkGl.Options(options)); each frame the window hands the runtime its WindowFrame and events (GetEvents).</Description>
    <PackageTags>$(PackageTags);window;glfw;opengl;silk.net</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui-core/bibui-core.csproj" />
    <!-- GlTarget: what the window's GL framebuffer is, for a renderer on it. -->
    <ProjectReference Include="../bibui-gl/bibui-gl.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
