<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <!-- The cross-platform window: GLFW through Silk.NET, presenting with
       OpenGL (a renderer draws into its framebuffer, or into memory it uploads),
       clipboard through TextCopy and wl-clipboard. It references no renderer:
       an app opens one with SilkWindow.Open(runtime, options) and runs the loop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Platform.Silk</AssemblyName>
    <RootNamespace>Bibui.Runtime.Platform</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Bibui.Platform.Silk</PackageId>
    <Description>Bibui cross-platform window: GLFW + OpenGL through Silk.NET, clipboard through TextCopy. SilkWindow.Open(runtime, options), then SilkWindow.BeginFrame/EndFrame around each frame.</Description>
    <PackageTags>$(PackageTags);window;glfw;opengl;silk.net</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui/bibui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
