<Project>
  <!--
    The docs' examples, compiled. Each docs/components/<slug>.md has an
    "## Example" section of whole C# files (```csharp blocks), each a class
    with fields for the caller's state and a Build(BibuiRuntime runtime)
    method. Before compiling, every block is written to
    $(IntermediateOutputPath)Examples/<slug>[-N].cs in a namespace of its own,
    with #line pointing back at the markdown (so an error is reported at the
    line in the .md), and Registry.g.cs maps each id to a factory: the first
    block of a page is its slug, the next ones <slug>-2, <slug>-3. An example
    that does not compile breaks the build.
  -->
  <PropertyGroup>
    <DocsComponentsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../docs/components/'))</DocsComponentsDir>
  </PropertyGroup>

  <UsingTask TaskName="ExtractDocsExamples" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Pages ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutDir ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
Directory.CreateDirectory(OutDir);
var written = new List<string>();
var registry = new List<(string Id, string Type)>();
foreach (var page in Pages.Select(p => p.GetMetadata("FullPath")).OrderBy(p => p, StringComparer.Ordinal))
{
    string slug = Path.GetFileNameWithoutExtension(page);
    string[] lines = File.ReadAllLines(page);
    int n = 0;
    bool inExample = false;
    for (int i = 0; i < lines.Length; i++)
    {
        string l = lines[i];
        if (Regex.IsMatch(l, @"^##\s")) { inExample = Regex.IsMatch(l, @"^##\s+Example\s*$"); continue; }
        if (!inExample || !Regex.IsMatch(l, @"^```(csharp|cs|c#)\s*$")) continue;
        int start = i + 1, end = start;
        while (end < lines.Length && !lines[end].StartsWith("```")) end++;
        var code = lines.Skip(start).Take(end - start).ToList();
        i = end;
        n++;
        string id = n == 1 ? slug : slug + "-" + n;
        string ns = "DocsExamples." + string.Concat(slug.Split('-').Select(w => char.ToUpperInvariant(w[0]) + w.Substring(1))) + "Page" + (n == 1 ? "" : n.ToString());

        // The class whose instance method is Build(BibuiRuntime runtime).
        // (Named <Slug>Page: a namespace named like a component, DocsExamples.Avatar,
        // would hide the Avatar type from the example's own code.)
        string text = string.Join("\n", code);
        var build = Regex.Match(text, @"public\s+(?!static)[\w<>?.,\s]+?\s+Build\s*\(\s*BibuiRuntime\s+\w+\s*\)");
        if (!build.Success) { Log.LogWarning($"{page}({start}): example {n} has no Build(BibuiRuntime) method; skipped"); continue; }
        var cls = Regex.Matches(text.Substring(0, build.Index), @"\b(?:class|record)\s+(\w+)").Cast<Match>().LastOrDefault();
        if (cls is null) { Log.LogWarning($"{page}({start}): example {n} has no class around Build; skipped"); continue; }

        // The namespace goes on the line of the last leading using (or the
        // first line), so every line keeps its number for #line.
        int lastUsing = -1;
        for (int k = 0; k < code.Count; k++)
        {
            string t = code[k].Trim();
            if (t.Length == 0 || t.StartsWith("//")) continue;
            if (Regex.IsMatch(t, @"^(global\s+)?using\s+[\w.=\s]+;$")) { lastUsing = k; continue; }
            break;
        }
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated/> from " + Path.GetFileName(page) + ", example " + n + ". Edit the markdown, not this.");
        sb.AppendLine("#nullable enable");
        sb.AppendLine($"#line {start + 1} \"{page}\"");
        for (int k = 0; k < code.Count; k++)
        {
            if (k == lastUsing) sb.AppendLine(code[k] + " namespace " + ns + ";");
            else if (lastUsing < 0 && k == 0) sb.AppendLine("namespace " + ns + "; " + code[k]);
            else sb.AppendLine(code[k]);
        }
        string file = Path.Combine(OutDir, id + ".cs");
        string content = sb.ToString();
        if (!File.Exists(file) || File.ReadAllText(file) != content) File.WriteAllText(file, content);
        written.Add(file);
        registry.Add((id, "global::" + ns + "." + cls.Groups[1].Value));
    }
}

var reg = new StringBuilder();
reg.AppendLine("// <auto-generated/> by DocsExamples.targets from docs/components/*.md.");
reg.AppendLine("#nullable enable");
reg.AppendLine("namespace DocsExamples;");
reg.AppendLine("internal static class Registry");
reg.AppendLine("{");
reg.AppendLine("    /// <summary>Every example's id: a page's slug, then <c>slug-2</c>... for its later examples.</summary>");
reg.AppendLine("    public static readonly string[] Ids = [" + string.Join(", ", registry.Select(r => "\"" + r.Id + "\"")) + "];");
reg.AppendLine("    /// <summary>A new instance of the example (its own state), as a build; null for an unknown id.</summary>");
reg.AppendLine("    public static global::System.Action<global::Bibui.Runtime.BibuiRuntime>? Create(string id)");
reg.AppendLine("    {");
reg.AppendLine("        switch (id)");
reg.AppendLine("        {");
foreach (var (id, type) in registry)
    reg.AppendLine($"            case \"{id}\": {{ var e = new {type}(); return rt => e.Build(rt); }}");
reg.AppendLine("            default: return null;");
reg.AppendLine("        }");
reg.AppendLine("    }");
reg.AppendLine("}");
string regFile = Path.Combine(OutDir, "Registry.g.cs");
if (!File.Exists(regFile) || File.ReadAllText(regFile) != reg.ToString()) File.WriteAllText(regFile, reg.ToString());
written.Add(regFile);
// Stale files from an example that went away.
foreach (var f in Directory.GetFiles(OutDir, "*.cs")) if (!written.Contains(f)) File.Delete(f);
Files = written.Select(f => (Microsoft.Build.Framework.ITaskItem)new Microsoft.Build.Utilities.TaskItem(f)).ToArray();
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, $"Docs examples: {registry.Count} from {Pages.Length} pages: {string.Join(", ", registry.Select(r => r.Id))}");
]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <DocsComponentPage Include="$(DocsComponentsDir)*.md" />
  </ItemGroup>

  <!-- IntermediateOutputPath is only known once the SDK's targets are in. -->
  <Target Name="_DocsExamplesDir">
    <PropertyGroup>
      <DocsExamplesDir>$(IntermediateOutputPath)Examples/</DocsExamplesDir>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateDocsExamples" BeforeTargets="CoreCompile" DependsOnTargets="_DocsExamplesDir" Inputs="@(DocsComponentPage);$(MSBuildThisFileFullPath)" Outputs="$(DocsExamplesDir)Registry.g.cs">
    <ExtractDocsExamples Pages="@(DocsComponentPage)" OutDir="$(DocsExamplesDir)" />
  </Target>
  <!-- Always add the files, whether or not the target above was skipped as up to date. -->
  <Target Name="AddDocsExamples" BeforeTargets="CoreCompile" AfterTargets="GenerateDocsExamples">
    <ItemGroup>
      <Compile Include="$(DocsExamplesDir)*.cs" />
    </ItemGroup>
  </Target>
</Project>
