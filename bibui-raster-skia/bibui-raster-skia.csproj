<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <!-- bibui's IRasterBackend on SkiaSharp, out of the core library, so an
       app that draws with another backend (the managed rasterizer)
       ships no libSkiaSharp. Referencing it makes Skia the backend the
       parameterless new BibuiRenderer() / new BibuiRuntime() pick
       (Bibui.RasterBackends). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Raster.Skia</AssemblyName>
    <RootNamespace>Bibui.Raster.Skia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Pins caller spans (pixels in, pixels out) with `fixed`. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <PackageId>Bibui.Raster.Skia</PackageId>
    <Description>Bibui's SkiaSharp raster backend. Referencing it makes Skia the default for new BibuiRenderer() and new BibuiRuntime().</Description>
    <PackageTags>$(PackageTags);skia;skiasharp;rendering</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui/bibui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
