<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <!-- The desktop's own dialogs through xdg-desktop-portal: a file chooser
       for any bibui window, over a D-Bus client of its own on the session
       bus socket. No dependency, no reflection; Linux only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Platform.Portal</AssemblyName>
    <RootNamespace>Bibui.Platform.Portal</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Bibui.Platform.Portal</PackageId>
    <Description>Bibui's door to xdg-desktop-portal: the desktop's own file chooser, asked over the session bus, without blocking the frame loop. Native AOT clean, no dependencies.</Description>
    <PackageTags>$(PackageTags);portal;file-chooser;dbus;wayland;aot</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="bibui-portal-tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
