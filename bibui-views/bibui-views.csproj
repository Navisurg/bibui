<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />
  <!-- Bibui.Views: the lenses' drawing halves (Bibui.Commands' Lenses) as bibui widgets, UIView,
       out of Bibui.Commands, which needs nothing of the rest of bibui. An app gives it its table of
       drawers by lens name; the context (Bibui.Commands' Context) says what is being drawn. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Views</AssemblyName>
    <RootNamespace>Bibui.Views</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <UseAppHost>false</UseAppHost>
    <PackageId>Bibui.Views</PackageId>
    <Description>A model's values drawn as bibui widgets through their lenses: fields, tables, rows and picks, a node's row of commands made from the context it is drawn in, and an app's own lenses by name.</Description>
    <PackageTags>$(PackageTags);lenses;views</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui-core/bibui-core.csproj" />
    <ProjectReference Include="../bibui-commands/bibui-commands.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
